# Copy to .env.local and fill in values from Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Resend (server-only). Without it, broadcast emails queue and in-app still sends.
RESEND_API_KEY=
RESEND_FROM=BDP CRM <updates@mathengeinc.com>
# Cron (server-only). Vercel Cron sends this as a Bearer token to
# /api/tasks/reminders at midday + before close (Africa/Nairobi).
# Generate: openssl rand -hex 32. Also add it as VERCEL env var + set the
# same value in Vercel → Project → Settings → Environment Variables.
CRON_SECRET=
